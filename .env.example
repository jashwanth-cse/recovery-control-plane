APP_NAME="Revenue Recovery Control Plane"
APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_USER=recovery
POSTGRES_PASSWORD=recovery
POSTGRES_DB=recovery_control_plane
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://recovery:recovery@postgres:5432/recovery_control_plane

REDIS_URL=redis://redis:6379/0

API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Razorpay Test Mode settings. Keep real values out of git.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_PREVIOUS_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_TIMEOUT_SECONDS=10
RAZORPAY_TEST_MODE_ONLY=true
RAZORPAY_WEBHOOK_MAX_BODY_BYTES=1000000

RECOVERY_WINDOW_DAYS=14
ABANDONED_ORDER_AGE_MINUTES=30
